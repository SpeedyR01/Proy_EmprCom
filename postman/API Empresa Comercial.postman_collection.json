    {
      "name": "Identidad y Acceso",
      "item": [
        {
          "name": "1. Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base-url}}/",
              "host": [
                "{{base-url}}"
              ],
              "path": [
                ""
              ]
            },
            "description": "Verifica que el servidor este corriendo."
          },
          "response": []
        },
        {
          "name": "2. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda el token devuelto en la variable de coleccion {{token}}\nconst data = pm.response.json();\nif (data && data.token) {\n    pm.collectionVariables.set('token', data.token);\n    console.log('Token guardado. Roles:', data.roles);\n}\npm.test('login responde 200', function () {\n    pm.response.to.have.status(200);\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre_usuario\": \"{{usuario}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            },
            "url": {
              "raw": "{{base-url}}/auth/login",
              "host": [
                "{{base-url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Valida usuario/contrasena contra identidad.usuarios y devuelve un JWT. Usa las variables {{usuario}} y {{password}}; para probar otro rol, cambia esos valores en la pestana Variables y vuelve a enviar."
          },
          "response": []
        },
        {
          "name": "3. Listar usuarios (admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base-url}}/usuarios",
              "host": [
                "{{base-url}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "description": "Requiere token de un usuario con rol ADMINISTRADOR. Sin token -> 401. Con token de no-admin -> 403."
          },
          "response": []
        },
        {
          "name": "4. Crear usuario (admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_empleado\": 5,\n  \"nombre_usuario\": \"nuevo_user\",\n  \"password\": \"clave_segura_123\"\n}",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            },
            "url": {
              "raw": "{{base-url}}/usuarios",
              "host": [
                "{{base-url}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "description": "Crea un usuario (la contrasena se hashea en el backend). id_empleado debe existir en identidad.empleados y no tener ya usuario (UNIQUE)."
          },
          "response": []
        },
        {
          "name": "5. Asignar rol a usuario (admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_rol\": 4\n}",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            },
            "url": {
              "raw": "{{base-url}}/usuarios/9/roles",
              "host": [
                "{{base-url}}"
              ],
              "path": [
                "usuarios",
                "9",
                "roles"
              ]
            },
            "description": "Asigna un rol al usuario indicado en la ruta (cambia el 9 por el id_usuario real). id_rol: 1=ADMINISTRADOR, 2=COMPRADOR, 3=BODEGUERO, 4=VENDEDOR, 5=CAJERO, 6=AUDITOR."
          },
          "response": []
        }
      ]
    },
